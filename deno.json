{
  "tasks": {
    "check": "deno check src/cli.ts",
    "fmt": "deno fmt",
    "lint": "deno lint",
    "test": "deno test --allow-read --allow-write=./reports --allow-env=GITHUB_TOKEN --allow-net=api.github.com,host.docker.internal --allow-run=gitleaks,trivy",
    "run": "deno run --allow-read --allow-write=./reports --allow-env=GITHUB_TOKEN --allow-net=api.github.com,host.docker.internal --allow-run=gitleaks,trivy src/cli.ts"
  },
  "fmt": {
    "lineWidth": 100,
    "indentWidth": 2,
    "useTabs": false
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "compilerOptions": {
    "strict": true
  }
}
