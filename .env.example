# repo-sentry 設定テンプレート
# このファイルを .env にコピーして値を設定してください
# cp .env.example .env

# GitHub Personal Access Token（dependabot使用時に必要）
GITHUB_TOKEN=

# Slack通知用Webhook URL（任意）
SLACK_WEBHOOK_URL=

# -------------------------------------------------------------------
# Clearwing (LLM分析) 設定
# -------------------------------------------------------------------

# プロバイダーを明示的に指定する場合
# 省略時: OPENAI_API_KEY が設定されていれば openai、なければ ollama
# CLEARWING_PROVIDER=openai
# CLEARWING_PROVIDER=ollama

# OpenAI を使う場合
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Ollama を使う場合
OLLAMA_MODEL=qwen2.5:7b

# -------------------------------------------------------------------
# sentry-report (レポート生成) 設定
# -------------------------------------------------------------------

# レポート生成に使う LLM プロバイダー（省略時は CLEARWING_PROVIDER または ollama）
# REPORT_LLM_PROVIDER=ollama
# REPORT_LLM_PROVIDER=openai

# Ollama モデル（省略時は OLLAMA_MODEL にフォールバック）
# REPORT_LLM_MODEL=qwen2.5:14b

# レポート言語: en（デフォルト）または ja
# REPORT_LANG=en
# REPORT_LANG=ja

# レポートファイル名のタイムスタンプ形式
# none: なし / date: YYYYMMDD / datetime: YYYYMMDD-HHMM / hour: YYMMDDHH（デフォルト）
# DATE_FORMAT=hour
