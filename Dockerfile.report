ARG DENO_VERSION=2.5.6

FROM denoland/deno:${DENO_VERSION}

USER root

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY deno.json README.md ./
COPY src/ ./src/

RUN deno cache src/sentry-report/cli.ts

RUN mkdir -p /workspace/reports /workspace/.repo-sentry \
  && chown -R deno:deno /workspace /app

ENV DENO_DIR=/workspace/.repo-sentry/deno-cache

WORKDIR /workspace
USER deno

ENTRYPOINT ["deno", "run", \
  "--allow-read=/app,/workspace", \
  "--allow-write=/workspace/reports,/workspace/.repo-sentry", \
  "--allow-env=DENO_DIR,OPENAI_API_KEY,OPENAI_MODEL,REPORT_LLM_PROVIDER,REPORT_LLM_MODEL,OLLAMA_BASE_URL,CLEARWING_PROVIDER,OLLAMA_MODEL,OLLAMA_HOST", \
  "--allow-net=api.openai.com,host.docker.internal", \
  "/app/src/sentry-report/cli.ts"]

CMD ["--help"]
