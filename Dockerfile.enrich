ARG DENO_VERSION=2.5.6

FROM denoland/deno:${DENO_VERSION}

USER root

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY deno.json README.md ./
COPY src/ ./src/

RUN deno cache src/sentry-enrich/cli.ts

RUN mkdir -p /workspace/reports /workspace/.repo-sentry \
  && chown -R deno:deno /workspace /app

ENV DENO_DIR=/workspace/.repo-sentry/deno-cache

WORKDIR /workspace
USER deno

ENTRYPOINT ["deno", "run", "--allow-read=/app,/workspace", "--allow-write=/workspace/reports,/workspace/.repo-sentry", "--allow-env=DENO_DIR,GITHUB_TOKEN", "--allow-net=api.osv.dev,www.cisa.gov,api.first.org,api.github.com,gitlab.com", "/app/src/sentry-enrich/cli.ts"]

CMD ["--help"]
